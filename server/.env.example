# ---- Server ----
PORT=5000
CLIENT_URL=http://localhost:5173

# ---- MongoDB ----
# Local:      mongodb://127.0.0.1:27017/therapy-booking
# Atlas:      mongodb+srv://<user>:<password>@<cluster>.mongodb.net/therapy-booking
MONGO_URI=mongodb://127.0.0.1:27017/therapy-booking

# ---- Email (Nodemailer via Gmail SMTP) ----
# 1. Use a Google account (a dedicated one for the clinic is best).
# 2. Turn on 2-Step Verification: https://myaccount.google.com/security
# 3. Create an "App Password": https://myaccount.google.com/apppasswords
#    (choose app: Mail, device: Other -> "Therapy Website")
# 4. Paste the 16-character app password below (NOT your normal Gmail password).
EMAIL_USER=your_mail
EMAIL_APP_PASSWORD=your16charapppassword
CLINIC_NOTIFY_EMAIL=your_mail

# ---- Razorpay (payment gateway) ----
# Sign up at https://dashboard.razorpay.com/  (India-first, supports UPI/cards/netbanking)
# Get keys from Settings -> API Keys. Start with TEST mode keys, switch to live keys after KYC.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret

# ---- Session price (in INR) ----
SESSION_PRICE_INR=1500

# ---- Feedback moderation ----
# A password-like secret used to approve testimonials before they show up
# publicly on the homepage. Make this a long random string. Use it like:
# PATCH https://your-api-url/api/feedback/<feedback-id>/approve?key=YOUR_SECRET
# See README "Approving testimonials" section for the full workflow.
ADMIN_SECRET=change-this-to-a-long-random-string
