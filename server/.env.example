# ---- Email (Resend) ----
# We use Resend (https://resend.com) instead of Gmail SMTP because Gmail
# logins from shared cloud-hosting IPs (Render, Heroku, etc.) routinely time
# out or get throttled by Google -- it's not fixable from our side. Resend
# sends over plain HTTPS, which cloud hosts never block.
#
# 1. Sign up at https://resend.com (free tier covers this volume easily).
# 2. Create an API key: https://resend.com/api-keys -- paste it below.
#    "Sending access" scope is fine (and safer) -- it just can't verify its
#    own domain-list, which is expected and not an error.
# 3. To send to real clients (not just your own inbox), verify a domain you
#    own: https://resend.com/domains -> Add Domain, then follow their DNS
#    instructions.
# 4. Once a domain is verified, set EMAIL_FROM to an address on it, e.g.
#    EMAIL_FROM=The Calm Space <hello@thecalmspace.com>
#
# IMPORTANT: EMAIL_FROM can NEVER be a gmail.com / yahoo.com / outlook.com
# address (or any domain you don't personally own) -- Resend will reject
# every send with "domain is not verified", because verification means
# proving ownership via DNS records, which is only possible for a domain
# you actually control. If you don't have a domain yet, leave EMAIL_FROM
# unset/commented out below -- it'll fall back to Resend's sandbox address
# (onboarding@resend.dev), which works immediately but can only deliver to
# the email address your Resend account itself is signed up with. That's
# enough to test clinic-notification emails (since CLINIC_NOTIFY_EMAIL
# below is presumably the same address), but auto-replies to real clients
# won't go out until a real domain is verified.
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=onboarding@resend.dev


# Where automated notifications (new bookings, contact messages, feedback)
# get sent, and where "reply" on client-facing emails will actually land.
EMAIL_USER=kanchan.s.pandey@gmail.com
CLINIC_NOTIFY_EMAIL=kanchan.s.pandey@gmail.com

# ---- Razorpay (payment gateway) ----
# Sign up at https://dashboard.razorpay.com/  (India-first, supports UPI/cards/netbanking)
# Get keys from Settings -> API Keys. Start with TEST mode keys, switch to live keys after KYC.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret

# ---- Session price (in INR) ----
SESSION_PRICE_INR=1500

# ---- Feedback moderation ----
# A password-like secret used to approve testimonials before they show up
# publicly on the homepage. Make this a long random string. Use it like:
# PATCH https://your-api-url/api/feedback/<feedback-id>/approve?key=YOUR_SECRET
# See README "Approving testimonials" section for the full workflow.
ADMIN_SECRET=change-this-to-a-long-random-string
